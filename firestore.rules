rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{d}   { allow read: if true; allow write: if request.auth != null; }
    match /activities/{d} { allow read: if true; allow write: if request.auth != null; }
    match /gallery/{d}    { allow read: if true; allow write: if request.auth != null; }
    match /team/{d}       { allow read: if true; allow write: if request.auth != null; }

    // Pendaftar: publik hanya boleh mengirim. Admin hanya boleh membaca,
    // menghapus, dan menambah foto / menautkan ke daftar anggota.
    // Biodata yang dikirim pendaftar TIDAK bisa diubah siapa pun.
    match /members/{d} {
      allow create: if true;
      allow read, delete: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo','teamId']);
    }

    match /feedback/{d}   { allow create: if true; allow read, update, delete: if request.auth != null; }
  }
}
